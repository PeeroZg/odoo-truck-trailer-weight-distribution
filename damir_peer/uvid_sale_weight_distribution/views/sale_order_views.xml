<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <record id="view_order_form_weight_distribution" model="ir.ui.view">
    <field name="name">view_order_form_weight_distribution</field>
    <field name="model">sale.order</field>
    <field name="inherit_id" ref="sale.view_order_form"/>
    <field name="arch" type="xml">
      <notebook position="inside">
        <page string="Truck and trailer" name="weight_distribution">
          <group>
            <group>
              <field name="package_weights_input"/>
              <field name="truck_packages"/>
              <field name="trailer_packages"/>
            </group>
          </group>
        </page>
      </notebook>
    </field>
  </record>

         
</odoo>
